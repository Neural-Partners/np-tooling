#!/usr/bin/env node
/**
 * pimsg — send a message to a Pi/pi-bridge session from anywhere
 *
 * Usage:
 *   pimsg list                          List all visible Pi sessions
 *   pimsg list --all                    Include invisible sessions for diagnostics
 *   pimsg <target> <message...>         Send a message to a session
 *   pimsg --reply <target> <message...> Send a reply (no further reply expected)
 *
 * <target> can be a session name, PID, or working directory basename.
 */

"use strict";

const path = require("node:path");
const core = require("../lib/pi-bridge-core.js");

function die(msg, code = 1) {
  process.stderr.write(msg + "\n");
  process.exit(code);
}

const os = require("node:os");
const BRIDGE_POLICY_FILE = path.join(
  os.homedir(),
  ".pi",
  "agent",
  "bridge-policy.json",
);

function maybeFocusSession(session) {
  const policy = core.readBridgePolicy(BRIDGE_POLICY_FILE);
  return core.maybeFocusSession(session, policy);
}

function focusSuffix(focus) {
  if (!focus) return "";
  if (focus.focused) return " — focused their tab";
  if (focus.frontmostApp && /not allowed/i.test(focus.reason || "")) {
    return ` — focus skipped: ${safeText(focus.frontmostApp, 80)} is frontmost`;
  }
  return "";
}

function safeText(value, maxBytes = 500) {
  return core.sanitizeMetadata(value, maxBytes);
}

function safeSession(session) {
  return core.sanitizeSessionForDisplay(session);
}

function printHelp() {
  console.log([
    "Usage:",
    "  pimsg list                         List all visible Pi sessions",
    "  pimsg list --all                   Include invisible sessions for diagnostics",
    "  pimsg list --with-status           List sessions with self-reported status",
    "  pimsg state <target|--all>         Show bridge state for one or all sessions",
    "  pimsg <target> <message...>        Send a message to a session",
    "  pimsg --reply <target> <message..> Send a reply (no further reply expected)",
    "  pimsg doctor [--fix] [--sync-shims] Inspect or repair IPC permissions and local shims",
    "",
    "<target> can be a session name, PID, or working directory basename.",
    "Ambiguous fuzzy targets fail closed and print candidate sessions.",
    "",
    "Examples:",
    "  pimsg list",
    '  pimsg backend "what does the auth endpoint return?"',
    "  pimsg --reply backend here is what I found",
    "  pimsg 83421 deploying now, heads up",
  ].join("\n"));
}

function visibilityLabel(session) {
  return core.normalizeBridgeVisibility(session && session.bridgeVisibility) === "invisible" ? "  [invisible]" : "";
}

function statusLabel(session) {
  const state = core.readBridgeState();
  const self = core.findSessionState(session, state);
  const status = core.normalizeSessionStatus(self && self.status);
  return status === "unknown" ? "" : `  [${status}]`;
}

function formatPermissionFinding(finding, fix) {
  if (finding.issue === "symbolic-link") {
    return `  ${finding.path} symbolic-link -> expected ${finding.expectedMode.toString(8)} regular bridge-owned file/socket${fix ? " not modified" : ""}`;
  }
  return `  ${finding.path} ${finding.actualMode.toString(8)} -> ${finding.expectedMode.toString(8)}${fix ? " fixed" : ""}`;
}

function listSessions(options = {}) {
  const allSessions = core.activeSessions();
  const sessions = options.includeInvisible ? allSessions : core.visibleSessions(allSessions);
  const myCwd = process.cwd();

  const color = process.stdout.isTTY && !process.env.NO_COLOR;
  const RESET = color ? "\x1b[0m" : "";
  const BOLD = color ? "\x1b[1m" : "";
  const DIM = color ? "\x1b[2m" : "";
  const CYAN = color ? "\x1b[96m" : "";

  if (sessions.length === 0) {
    console.log("No active Pi sessions found.");
    return;
  }

  console.log("Active Pi sessions:");
  for (const rawSession of sessions) {
    const session = safeSession(rawSession);
    const age = Math.round((Date.now() - rawSession.startedAt) / 60_000);
    const isCurrent = rawSession.cwd === myCwd;
    const bullet = isCurrent ? `${CYAN}${BOLD}▶${RESET}` : " •";
    const label = isCurrent ? `  ${CYAN}${DIM}← you${RESET}` : "";
    const nameStr = isCurrent
      ? `${CYAN}${BOLD}${session.name.padEnd(20)}${RESET}`
      : session.name.padEnd(20);
    const pidStr = isCurrent
      ? `${CYAN}${BOLD}pid:${String(rawSession.pid).padEnd(7)}${RESET}`
      : `pid:${String(rawSession.pid).padEnd(7)}`;
    const sc = session.supacodeTabId ? `  [💻 ${session.supacodeTabId.slice(0, 8)}]` : "";
    const visibility = visibilityLabel(rawSession);
    const state = options.withStatus ? statusLabel(rawSession) : "";
    console.log(`  ${bullet} ${nameStr} ${pidStr} ${session.cwd}  (${age}m ago)${sc}${visibility}${state}${label}`);
  }

  const duplicates = core.duplicateCwdWarnings(sessions, { includeInvisible: options.includeInvisible });
  if (duplicates.length > 0) {
    console.log("\n⚠️ Duplicate cwd sessions detected — target canonical PID/name explicitly:");
    for (const duplicate of duplicates) console.log(`  - ${duplicate}`);
  }
}

async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0 || args[0] === "--help" || args[0] === "-h") {
    printHelp();
    return;
  }

  if (args[0] === "list") {
    listSessions({ includeInvisible: args.includes("--all"), withStatus: args.includes("--with-status") });
    return;
  }

  if (args[0] === "doctor") {
    const fix = args.includes("--fix");
    const syncShims = args.includes("--sync-shims");
    const result = core.doctorIpcPermissions({
      fix,
      extraFiles: [
        path.join(require("node:os").homedir(), ".pi", "agent", "bridge-roster.json"),
        path.join(require("node:os").homedir(), ".pi", "agent", "bridge-policy.json"),
        path.join(require("node:os").homedir(), ".pi", "agent", "tool-usage.jsonl"),
      ],
    });
    if (result.findings.length === 0) {
      console.log(`✓ pi-bridge IPC permissions OK (${result.ipcDir})`);
    } else {
      console.log(`${fix ? "✓ Fixed" : "⚠️ Found"} ${result.findings.length} permission issue(s):`);
      for (const finding of result.findings) {
        console.log(formatPermissionFinding(finding, fix));
      }
      if (!fix) console.log("Run: pimsg doctor --fix");
    }
    if (syncShims) {
      const synced = core.syncLocalShims();
      console.log(core.formatShimDiagnostics(synced));
    } else {
      console.log(core.formatShimDiagnostics(core.diagnoseShimVersions()));
    }
    return;
  }

  if (args[0] === "state") {
    const target = args[1] || "--all";
    const report = core.buildSessionStateReport(target, { includeGit: true });
    if (report.status !== "found") die(report.text);
    console.log(report.text);
    return;
  }

  let isReply = false;
  let sendArgs = args;
  if (args[0] === "--reply" || args[0] === "-r") {
    isReply = true;
    sendArgs = args.slice(1);
  }

  const target = sendArgs[0];
  const messageText = sendArgs.slice(1).join(" ").trim();

  if (!target || !messageText) {
    die("Usage: pimsg <target> <message...>\n       pimsg --reply <target> <message...>\n       pimsg list");
  }

  const sessions = core.activeSessions();
  const resolution = core.resolveSessionTarget(target, sessions);

  if (resolution.status === "ambiguous") {
    die(
      `Ambiguous session target "${safeText(target, 200)}" matched multiple sessions by ${resolution.matchKind}.\n` +
      `Candidates:\n  ${core.formatCandidateList(resolution.candidates)}`,
    );
  }

  if (resolution.status !== "found") {
    die(
      `Session "${safeText(target, 200)}" not found.\n` +
      `Available:\n  ${core.formatCandidateList(sessions)}`,
    );
  }

  const session = resolution.session;
  const fromName = path.basename(process.cwd());
  const message = {
    id: core.newMessageId(isReply ? "reply" : "msg"),
    type: "message",
    fromPid: process.pid,
    fromName,
    fromCwd: process.cwd(),
    content: messageText,
    timestamp: Date.now(),
    isReply,
  };

  const verb = isReply ? "Reply sent" : "Sent";

  try {
    const receipt = await core.sendToSocket(session.socketPath, message);
    const focus = maybeFocusSession(session);
    const safe = safeSession(session);
    const warning = core.retentionWarning(receipt);
    const ack = (receipt.acked ? " — ACK received" : ` — delivered, but ${receipt.warning}`) + (warning ? ` — Warning: ${warning}` : "");
    console.log(
      `✓ ${verb} to "${safe.name}" (${safe.cwd})${focusSuffix(focus)}${ack}`,
    );
  } catch (err) {
    die(`✗ Failed to deliver to "${safeSession(session).name}": ${err.message}`);
  }
}

main().catch((err) => die(err && err.stack ? err.stack : String(err)));
