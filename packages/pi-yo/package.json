{
  "name": "@neuralpartners/pi-yo",
  "version": "0.4.0",
  "description": "Inter-terminal messaging for Pi agents and Claude Code sessions.",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "bridge",
    "ipc"
  ],
  "license": "MIT",
  "bin": {
    "pimsg": "bin/pimsg",
    "pi-cc-bridge": "bin/pi-cc-bridge",
    "piroom": "bin/piroom"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-bridge.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/Neural-Partners/np-tooling/main/packages/pi-yo/assets/pi-to-claude-code-flow.png"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.0",
    "typebox": "^1.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "smoke:rooms": "node scripts/smoke-rooms.js",
    "syntax": "node -c lib/pi-bridge-core.js && node -c bin/pimsg && node -c bin/pi-cc-bridge && node -c bin/piroom && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --strict --esModuleInterop extensions/pi-bridge.ts",
    "verify": "npm run test && npm run syntax"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neural-Partners/np-tooling.git",
    "directory": "packages/pi-yo"
  },
  "bugs": {
    "url": "https://github.com/Neural-Partners/np-tooling/issues"
  },
  "homepage": "https://github.com/Neural-Partners/np-tooling/tree/main/packages/pi-yo#readme"
}
